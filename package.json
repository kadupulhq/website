{
  "name": "kadupul-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-map.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:prose": "node scripts/lint-prose.mjs",
    "check:all": "npm run translations:check && npm run check && npm run lint:prose && npm run check:maps && npm run build && npm run test:coverage && npm run check:links && npm run check:locales",
    "check:locales": "node scripts/check-locales.mjs",
    "build:map": "node scripts/build-map.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "npm run translations:check && npm run check:maps && npm run build && node --test \"scripts/__tests__/*.test.mjs\"",
    "test:coverage": "c8 node --test \"scripts/__tests__/*.test.mjs\"",
    "check:maps": "node scripts/build-map.mjs --check",
    "translations:build": "node scripts/site-translations.mjs",
    "translations:check": "node scripts/site-translations.mjs --check"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.1",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "starlight-versions": "^0.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/compiler-rs": "^0.4.0",
    "c8": "^12.0.0",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
