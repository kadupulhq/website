{
  "name": "kadupul-website",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-map.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:prose": "node scripts/lint-prose.mjs",
    "check:all": "npm run check && npm run lint:prose && npm test && npm run build && npm run check:links && npm run check:locales",
    "check:locales": "node scripts/check-locales.mjs",
    "build:map": "node scripts/build-map.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test": "node --test \"scripts/__tests__/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2",
    "sharp": "^0.35.4",
    "starlight-versions": "^0.10.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "parse5": "^8.0.1",
    "typescript": "^6.0.3"
  }
}
